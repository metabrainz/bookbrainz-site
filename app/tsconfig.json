{
	"compilerOptions": {
		"esModuleInterop": true,
		"jsx": "react",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"rootDirs": [
			".",
			"../.react-router/types/app"
		],
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": [
			"node",
			"vite/client"
		]
	},
	"include": [
		"./**/*",
		"../.react-router/types/**/*",
		"../vite.config.mts",
		"../react-router.config.ts",
		"../src/backend/**/*.ts",
		"../src/common/types/site.ts",
		"../src/common/helpers/error.ts"
	]
}
