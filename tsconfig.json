{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "preserve",
		"lib": [
			"ESNext",
			"DOM"
		],
		"module": "CommonJS",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "ESNext"
	},
	"exclude": [
		"node_modules",
		"lib",
		"build-router",
		"app",
		"src/server/helpers/router-build/*.ts",
		"vite.config.mts",
		"react-router.config.ts"
	]
}
